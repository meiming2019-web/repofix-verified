    "candidate_patch": "--- a/src/click/core.py\n+++ b/src/click/core.py\n@@ -2625,6 +2625,11 @@\n                 )\n                 echo(style(message, fg=\"red\"), err=True)\n \n+            # Make the source available while the parameter's type converts the value.\n+            # Slot arbitration below will restore an existing source if this parameter\n+            # does not win the slot.\n+            ctx.set_parameter_source(self.name, source)\n+\n             # Process the value through the parameter's type.\n             try:\n                 value = self.process_value(ctx, value)\n@@ -2658,10 +2663,10 @@\n             if self.expose_value:\n                 ctx.params[self.name] = value\n                 ctx._param_default_explicit[self.name] = self._default_explicit\n-        elif existing_source is None:\n-            # Nothing has claimed the slot yet. Record at least our source so downstream\n-            # lookups don't return ``None``.\n-            ctx.set_parameter_source(self.name, source)\n+        elif existing_source is not None:\n+            # Conversion temporarily exposed this parameter's source. Restore the\n+            # source belonging to the parameter that retained the shared slot.\n+            ctx.set_parameter_source(self.name, existing_source)\n \n         return value, args\n \n",
